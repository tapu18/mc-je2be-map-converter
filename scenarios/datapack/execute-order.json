      "run": "summon marker 13 -60 8 {Tags:[\"worker\",\"first\"]}"
    },
    {
      "run": "summon marker 9 -60 8 {Tags:[\"worker\",\"second\"]}"
    },
    {
      "run": "summon marker 11 -60 8 {Tags:[\"worker\",\"third\"]}"
    },
    {
      "run": "scoreboard players set @e[type=marker,tag=first] identity 1"
    },
    {
      "run": "scoreboard players set @e[type=marker,tag=second] identity 2"
    },
    {
      "run": "scoreboard players set @e[type=marker,tag=third] identity 3"
    },
    {
      "run": "execute as @e[type=marker,tag=worker] run function m2:probe/record"
    }
  ],
  "observe": {
