{
  "repo": "tapu18/mc-je2be-map-converter",
  "agent": "codex",
  "base": "main",
  "pollSeconds": 60,
  "timeoutSeconds": 3600,
  "maxAttempts": 3,
  "maxRunsPerDay": 12,
  "autoMerge": true,
  "agentArgs": ["--approve-for-me"],
  "limitWaitSeconds": 3600,
  "workerOverrides": {
    "model:light": { "agentArgs": ["--approve-for-me", "-m", "ここに軽いモデルを指定"] },
    "model:strong": { "agent": "claude", "agentArgs": ["--model", "ここに強いモデルを指定", "--permission-mode", "auto"] }
  },
  "manager": {
    "enabled": true,
    "agent": "claude",
    "agentArgs": ["--permission-mode", "auto"],
    "intervalSeconds": 21600,
    "runWhenIdle": true,
    "minIntervalSeconds": 3600,
    "timeoutSeconds": 3600,
    "maxRunsPerDay": 3,
    "instructions": ""
  }
}
